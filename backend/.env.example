# BhuDrishti Sentinel-2 Processing Pipeline Configuration
# Copy this file to .env or set environment variables in your shell.

# Path to directory containing Sentinel-2 L2A .zip archives
BHUDRISHTI_INPUT_DIR=./data/input_zips

# Root directory for pipeline outputs and generated GeoTIFF mosaics
BHUDRISHTI_OUTPUT_DIR=./data/output

# Path to India official boundary shapefile (.shp)
BHUDRISHTI_INDIA_SHAPEFILE=./India_Shape_File/India_fixed.shp

# Temporary directory for isolated ZIP extractions
BHUDRISHTI_TEMP_DIR=./data/temp

# Processing engine mode: cpu or gpu
BHUDRISHTI_PROCESSING_MODE=cpu
